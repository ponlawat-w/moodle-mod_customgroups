{{!
    @template mod_customgroups/grouplist

    Paginated groups list rendering

    Example context (json):
    {
        "hasgroups": true,
        "groups": [
            {
                "name": "Group A",
                "viewurl": "/",
                "image": "/",
                "status": {
                    "text": "Available",
                    "class": "text-bg-success"
                },
                "details": [
                    {
                        "text": "2 members",
                        "class": "text-muted",
                        "first": true
                    },
                    {
                        "text": "1 needed",
                        "class": "text-warning",
                        "first": false
                    }
                ]
            }
        ],
        "pagingbar": ""
    }
}}
{{#hasgroups}}
    <div class="d-flex flex-column gap-2 my-2">
        {{#groups}}
            <a href="{{{viewurl}}}" class="mod_customgroups-listitem card text-reset text-decoration-none">
                <div class="card-body d-flex align-items-center gap-3 p-2">
                    <div class="mod_customgroups-thumbnail">
                        {{#image}}<img src="{{{image}}}" alt="">{{/image}}
                    </div>
                    <div class="mod_customgroups-name">
                        <div class="text-truncate fw-bold" title="{{name}}">{{name}}</div>
                        <div class="small">{{#details}}{{^first}}<span class="text-muted">・</span>{{/first}}<span class="{{class}}">{{text}}</span>{{/details}}</div>
                    </div>
                    {{#status}}
                        <span class="badge rounded-pill flex-shrink-0 {{class}}">{{text}}</span>
                    {{/status}}
                </div>
            </a>
        {{/groups}}
    </div>
    {{{pagingbar}}}
{{/hasgroups}}
{{^hasgroups}}
    <div class="alert alert-info">{{#str}} nogroupsyet, mod_customgroups {{/str}}</div>
{{/hasgroups}}
